    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'backend'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=backend"
                ]
            },
            "args": [],
            "env": {
                "RUST_BACKTRACE": "full",
                "DATABASE_URL": "postgres://admin:admin123@localhost:5432/mydatabase",
            }
        },
        {
            "name": "Debug unit tests in executable 'backend'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=backend"
                ]
            }
        }
    ]
}